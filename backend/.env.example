# Absolute or relative SQLite database file. Do not commit a populated database.
NEUROFAST_DATABASE_PATH=./neurofast.db

# Keep true only for hackathon demos. When false, configure NEUROFAST_API_KEYS.
NEUROFAST_DEMO_MODE=true

# Comma-separated browser origins.
NEUROFAST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted JSON request body, in bytes.
NEUROFAST_REQUEST_MAX_BYTES=1048576
NEUROFAST_RATE_LIMIT_PER_MINUTE=60

# Production transition only. Comma-separated secret:owner pairs.
# Store real secrets in a managed secret store, never in a committed .env file.
# NEUROFAST_API_KEYS=replace-with-long-secret:owner-001
