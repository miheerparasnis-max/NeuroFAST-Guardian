# Absolute or relative SQLite database file. Do not commit a populated database.
NEUROFAST_DATABASE_PATH=./neurofast.db

# Keep true for hackathon demos. Real notifications require an approved provider,
# consent workflow, rate limiting, audit logging, and legal review.
NEUROFAST_DEMO_MODE=true

# Comma-separated origins allowed to access the API from a browser during development.
NEUROFAST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
